{
    "name": "opencode-proxy",
    "version": "1.0.0",
    "description": "OpenAI-compatible proxy for OpenCode",
    "license": "MIT",
    "main": "index.ts",
    "type": "module",
    "engines": {
        "node": ">=23.6"
    },
    "scripts": {
        "start": "node index.ts",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "dependencies": {
        "@opencode-ai/sdk": "1.1.34",
        "axios": "^1.13.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "undici": "^7.29.0"
    },
    "devDependencies": {
        "@swc/core": "^1.16.1",
        "@swc/jest": "^0.2.39",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "typescript": "^5.9.3"
    },
    "jest": {
        "testEnvironment": "node",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleFileExtensions": [
            "ts",
            "js",
            "json"
        ],
        "testMatch": [
            "<rootDir>/tests/**/*.test.[jt]s?(x)"
        ],
        "transform": {
            "^.+\\.(t|j)sx?$": [
                "@swc/jest",
                {
                    "module": {
                        "type": "es6"
                    },
                    "jsc": {
                        "parser": {
                            "syntax": "typescript",
                            "tsx": false
                        }
                    }
                }
            ]
        }
    },
    "allowScripts": {
        "@swc/core@1.16.1": true
    }
}
